---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import { site } from '../data/site';
import { publicPath } from '../data/paths';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  noindex?: boolean;
  closing?: boolean;
}

const {
  title,
  description = site.description,
  image = '/assets/og-image.png',
  noindex = false,
  closing = true,
} = Astro.props;

const pageTitle = title ? `${title} | ${site.shortName}` : site.name;
const canonical = new URL(publicPath(Astro.url.pathname), site.url).href;
const ogImage = new URL(image, site.url).href;
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0a0a0a" />
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    {closing && <ClosingCTA />}
    <Footer />
  </body>
</html>
