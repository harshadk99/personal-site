---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import TerminalWindow from '../components/TerminalWindow.astro';
import { Content, frontmatter as about } from '../content/copy/about.md';
import { citations, monthYear, isoDate } from '../data/content';
---
<Base title="About" description="Security engineer in Austin, Texas, working on deception engineering and edge security.">
  <section class="wrap section">
    <SectionHead level={1} eyebrow={about.eyebrow} title={about.title} />
    <div class="prose"><Content /></div>

    <div class="mt-2">
      <TerminalWindow title="about.sh">
        <dl class="facts">
          {about.facts.map((f: { label: string; value: string; href?: string }) => (
            <><dt>{f.label}</dt><dd>{f.href ? <a href={f.href}>{f.value}</a> : f.value}</dd></>
          ))}
        </dl>
      </TerminalWindow>
    </div>

    <div class="actions mt-15">
      <a class="btn" href={about.resume.href}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z M14 3v5h5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/><path d="M9 13h6M9 17h4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
        {about.resume.label}
      </a>
    </div>
    <p class="meta mt-075">{about.resume.note}</p>
  </section>

  <section class="wrap section">
    <SectionHead title={about.recognition.heading} />
    <ol class="dated">
      {citations.map((c) => (
        <li>
          <time datetime={isoDate(c.date)}>{monthYear(c.date)}</time>
          <div>
            <h3><a href={c.url}>{c.heading}</a></h3>
            <p>{c.description}</p>
            <div class="links"><a href={c.url}>{c.link_label} →</a></div>
          </div>
        </li>
      ))}
    </ol>
  </section>
</Base>
