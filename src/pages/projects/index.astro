---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import { projectsByTrack, monthYear, isoDate } from '../../data/content';
---
<Base title="Projects" description="Open-source tools for deception engineering and edge security.">
  <section class="wrap section">
    <SectionHead level={1} eyebrow="Projects" title="Featured Projects" />
    {projectsByTrack.map((group) => (
      <div class="track">
        <h2 class="eyebrow">{group.label}</h2>
        <ol class="index">
          {group.items.map((p) => (
            <li>
              <div>
                <h3><a href={`/projects/${p.slug}`}>{p.name}</a></h3>
                <span class="status">Open source · since <time datetime={isoDate(p.released)}>{monthYear(p.released)}</time></span>
                <p>{p.description}</p>
                <ul class="tags" style="margin-top:0.9rem">{p.features.map((f) => <li class="tag">{f}</li>)}</ul>
                <div class="links" style="margin-top:0.9rem">
                  <a href={`/projects/${p.slug}`}>Details →</a>
                  <a href={p.repo}>View Repository</a>
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    ))}
  </section>
</Base>

<style>
  .track + .track { margin-top: 3rem; }
  .track > .eyebrow { margin-bottom: 1rem; }
</style>
