---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import { articles, byYear, monthYear, isoDate } from '../data/content';

const years = byYear(articles, (a) => String(a.date));
---
<Base title="Writing" description="Articles on deception engineering, AI agent security and edge security.">
  <section class="wrap section">
    <SectionHead level={1} eyebrow="Writing" title="My Articles" />
  </section>

  {years.map((y) => (
    <section class="wrap section">
      <h2 class="eyebrow">{y.year}</h2>
      <ol class="dated">
        {y.items.map((a) => (
          <li>
            <time datetime={isoDate(a.date)}>{monthYear(a.date)}</time>
            <div>
              <h3><a href={a.url}>{a.title}</a></h3>
              {a.summary && <p>{a.summary}</p>}
              <div class="links"><span>{a.where}</span><a href={a.url}>{a.link_label} →</a></div>
            </div>
          </li>
        ))}
      </ol>
    </section>
  ))}
</Base>
