---
import { profiles, site } from '../data/site';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="wrap row">
    <p class="meta">© {year} {site.name}</p>
    <ul>
      <li><a href="/about">About</a></li>
      <li><a href="/talks">Talks</a></li>
      <li><a href="/links">Links</a></li>
      {profiles.slice(0, 2).map((p) => <li><a href={p.href}>{p.label}</a></li>)}
    </ul>
  </div>
</footer>

<style>
  .site-footer { border-top: 1px solid var(--rule); }
  .row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: 2rem;
  }
  .row p { margin: 0; }
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    font: 400 var(--step--1) / 1 var(--mono);
    color: var(--muted);
    text-decoration: none;
  }
  a:hover { color: var(--accent); }
</style>
