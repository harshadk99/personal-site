---
// Homepage opening, carried over from the old site: name, title with a
// blinking cursor, a typed "$ ..." line, location, and two actions.
interface Action { label: string; href: string; primary?: boolean }
interface Props {
  name: string;
  title: string;
  typed: string[];
  location: string;
  actions: Action[];
}
const { name, title, typed, location, actions } = Astro.props;
const icon = (label: string) => (/resume/i.test(label) ? 'pdf' : 'terminal');
---
<section class="hero wrap">
  <h1 class="name glitch">{name}</h1>
  <p class="title">{title}<span class="caret" aria-hidden="true"></span></p>

  <p class="typed" aria-hidden="true">
    <span class="prompt">$</span>
    <span id="typed" data-lines={JSON.stringify(typed)}>{typed[0]}</span><span class="typed-caret"></span>
  </p>

  <p class="location">
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/><circle cx="12" cy="9.5" r="2.5" fill="none" stroke="currentColor" stroke-width="1.75"/></svg>
    {location}
  </p>

  <div class="actions">
    {actions.map((a) => (
      <a class:list={['btn', { 'btn-primary': a.primary }]} href={a.href}>
        {icon(a.label) === 'terminal' ? (
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="m4 7 5 5-5 5M12 18h8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        ) : (
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z M14 3v5h5" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/><path d="M9 13h6M9 17h4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
        )}
        {a.label}
      </a>
    ))}
  </div>
</section>

<script>
  // Type, pause, delete, next: same rhythm as the old site. With reduced
  // motion the first line simply stays put.
  const el = document.getElementById('typed');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (el && !reduced) {
    const lines: string[] = JSON.parse(el.dataset.lines ?? '[]');
    let line = 0;
    let chars = 0;
    let deleting = false;
    el.textContent = '';
    const tick = () => {
      const text = lines[line];
      chars += deleting ? -1 : 1;
      el.textContent = text.slice(0, chars);
      let delay = deleting ? 50 : 100;
      if (!deleting && chars === text.length) { deleting = true; delay = 1500; }
      else if (deleting && chars === 0) { deleting = false; line = (line + 1) % lines.length; delay = 500; }
      setTimeout(tick, delay);
    };
    setTimeout(tick, 400);
  }
</script>

<style>
  .hero {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0;
    padding-block: clamp(4.5rem, 12vw, 8rem) clamp(3.5rem, 8vw, 5.5rem);
    border-bottom: 1px solid var(--rule);
  }
  .name {
    font: 600 clamp(1.75rem, 1rem + 3.6vw, 3.25rem) / 1.1 var(--mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .title {
    margin: 1.25rem 0 0;
    font: 400 var(--step-1) / 1.4 var(--mono);
    color: var(--accent);
  }
  .caret {
    display: inline-block;
    width: 2px;
    height: 1.15em;
    margin-left: 0.35rem;
    vertical-align: -0.2em;
    background: var(--accent);
    animation: blink 1s step-end infinite;
  }
  .typed {
    margin: 1.25rem 0 0;
    min-height: 1.6em;
    font: 400 var(--step-0) / 1.6 var(--mono);
    color: var(--ink);
  }
  .prompt { color: var(--signal); margin-right: 0.6rem; }
  .typed-caret {
    display: inline-block;
    width: 0.55ch;
    height: 1.1em;
    margin-left: 1px;
    vertical-align: -0.15em;
    background: var(--muted);
    animation: blink 1s step-end infinite;
  }
  .location {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 1rem 0 0;
    font: 400 var(--step--1) / 1 var(--mono);
    color: var(--muted);
  }
  .actions { justify-content: center; margin-top: 2rem; }
  .btn { font-family: var(--mono); text-transform: uppercase; letter-spacing: 0.08em; font-size: 0.875rem; }
</style>
