---
// "Connect With Me" block on every page; text from src/content/copy/cta.md.
import TerminalWindow from './TerminalWindow.astro';
import { frontmatter as cta } from '../content/copy/cta.md';
const tel = cta.phone ? `tel:${cta.phone.replace(/[^+\d]/g, '')}` : '';
---
<section class="closing wrap" id="contact" aria-labelledby="contact-title">
  <h2 id="contact-title" class="statement glitch">{cta.title.replace(/[.]$/, '')}<span class="caret-blink" aria-hidden="true"></span></h2>
  <p class="lede">{cta.body}</p>
  <TerminalWindow title="contact.sh">
    <dl class="facts">
      <dt>Email</dt><dd><a href={`mailto:${cta.email}`}>{cta.email}</a></dd>
      {cta.phone && (<><dt>Phone</dt><dd><a href={tel}>{cta.phone}</a></dd></>)}
      <dt>Location</dt><dd>{cta.location}</dd>
      {cta.links.map((l: { label: string; url: string }) => (<><dt>{l.url.includes('linkedin') ? 'LinkedIn' : 'GitHub'}</dt><dd><a href={l.url}>{l.label}</a></dd></>))}
    </dl>
  </TerminalWindow>
</section>

<style>
  .closing {
    padding-block: var(--space-section);
    border-top: 1px solid var(--rule);
    margin-top: var(--space-section);
  }
  .statement { margin-bottom: 0.75rem; }
  .lede { margin-bottom: 1.75rem; }
</style>
