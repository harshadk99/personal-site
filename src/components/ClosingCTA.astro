---
import { site } from '../data/site';
---
<section class="closing wrap" aria-labelledby="closing-title">
  <div class="panel">
    <h2 id="closing-title" class="statement">Building detection for AI agents?</h2>
    <p>
      I'm glad to compare notes on deception engineering, speak at your event, or talk
      through a problem you're stuck on. If I'm not the right person, I'll say so.
    </p>
    <a class="email" href={`mailto:${site.email}`}>{site.email}</a>
  </div>
</section>

<style>
  .closing { padding-block: var(--space-section); }
  .panel {
    border-top: 1px solid var(--rule);
    padding-top: 2.5rem;
    max-width: var(--prose);
  }
  .statement { margin-bottom: 1rem; }
  p { color: var(--ink-soft); }
  .email {
    font: 500 var(--step-1) / 1.3 var(--mono);
    color: var(--accent);
    text-decoration: none;
    overflow-wrap: anywhere;
  }
  .email:hover { text-decoration: underline; }
</style>
