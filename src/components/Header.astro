---
import { nav, site } from '../data/site';
import { publicPath } from '../data/paths';

const path = publicPath(Astro.url.pathname);
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---
<header class="site-header">
  <div class="wrap bar">
    <a class="wordmark" href="/" aria-label={`${site.shortName}, home`}>
      <span class="chevron" aria-hidden="true">&gt;</span>HSK
    </a>
    <nav aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <button class="theme-toggle" type="button" id="theme-toggle" aria-label="Switch to light theme">
      <svg class="icon-sun" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.75"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"/></svg>
      <svg class="icon-moon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linejoin="round"/></svg>
    </button>
  </div>
</header>

<script>
  const button = document.getElementById('theme-toggle');
  const root = document.documentElement;
  const sync = () => {
    const light = root.dataset.theme === 'light';
    button?.setAttribute('aria-label', light ? 'Switch to dark theme' : 'Switch to light theme');
  };
  sync();
  button?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
    sync();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: color-mix(in srgb, var(--ground) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 1rem 2rem;
    min-height: 4rem;
    flex-wrap: wrap;
  }
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font: 700 1.5rem / 1 var(--mono);
    letter-spacing: 0.04em;
    color: var(--accent);
    text-shadow: var(--glow);
    text-decoration: none;
  }
  .wordmark:hover { color: var(--accent); }
  .chevron {
    opacity: 0.55;
    animation: blink 1s step-end infinite;
  }
  nav { margin-left: auto; }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    font: 400 0.9375rem / 1 var(--sans);
    color: var(--muted);
    text-decoration: none;
    padding-block: 0.4rem;
    border-bottom: 1px solid transparent;
  }
  nav a:hover { color: var(--ink); }
  nav a[aria-current='page'] { color: var(--ink); border-bottom-color: var(--accent); }

  .theme-toggle {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
  }
  .theme-toggle:hover { color: var(--accent); border-color: var(--accent); }
  .icon-moon { display: none; }
  :global([data-theme='light']) .icon-sun { display: none; }
  :global([data-theme='light']) .icon-moon { display: block; }

  @media (max-width: 40rem) {
    .bar { padding-block: 0.75rem; }
    nav { order: 3; margin-left: 0; width: 100%; }
    .theme-toggle { margin-left: auto; }
  }
</style>
