---
interface Props {
  eyebrow?: string;
  title: string;
  more?: { href: string; label?: string };
  level?: 1 | 2;
}
const { eyebrow, title, more, level = 2 } = Astro.props;
const Tag = level === 1 ? 'h1' : 'h2';
// Headings end with a blinking cursor; drop a trailing full stop if one was typed.
const text = title.replace(/[.]$/, '');
---
<div class="section-head">
  <div>
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <Tag class="statement glitch">{text}<span class="caret-blink" aria-hidden="true"></span></Tag>
  </div>
  {more && <a class="more" href={more.href}>{more.label ?? 'See everything'} →</a>}
</div>
